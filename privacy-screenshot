#!/bin/sh
set -eu

action=${1:-}
backend=${2:-}
[ "$action" = capture ] || exit 2

output_dir=${XDG_PICTURES_DIR:-}
if [ -z "$output_dir" ] && command -v xdg-user-dir >/dev/null 2>&1; then
  output_dir=$(xdg-user-dir PICTURES 2>/dev/null || true)
fi
output_dir=${output_dir:-"$HOME/Pictures"}
case "$output_dir" in /*) ;; *) output_dir="$HOME/Pictures" ;; esac
mkdir -p -- "$output_dir"
output="$output_dir/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

case "$backend" in
  grim)
    geometry=$(slurp) || exit 0
    partial="$output.partial"
    trap 'rm -f -- "$partial"' EXIT INT TERM
    grim -g "$geometry" "$partial"
    mv -- "$partial" "$output"
    command -v wl-copy >/dev/null 2>&1 && wl-copy --type image/png <"$output"
    ;;
  grim-satty)
    geometry=$(slurp) || exit 0
    grim -g "$geometry" - | satty --filename - --output-filename "$output" --copy-command wl-copy
    ;;
  hyprshot)
    exec hyprshot --freeze -m region -o "$output_dir" -f "$(basename -- "$output")"
    ;;
  flameshot)
    exec env QT_QPA_PLATFORM=wayland flameshot gui -p "$output_dir"
    ;;
  *) exit 2 ;;
esac
