{
  "schemaVersion": 1,
  "id": "io.github.bolens.privacy-devices",
  "name": "Privacy Devices",
  "version": "0.6.0",
  "author": "bolens",
  "license": "MIT",
  "description": "Unified, configurable privacy indicators for microphones, audio playback, cameras, screen sharing, screenshots, screen recording, and location access.",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Privacy Devices",
    "description": "Unified live privacy-device activity with per-application details.",
    "category": "Status",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "enabledKinds": ["microphone", "audio-output", "camera", "screen-share", "screenshot", "screen-recording", "location"],
      "order": ["screen-recording", "screenshot", "screen-share", "camera", "microphone", "audio-output", "location"],
      "showIdle": false,
      "displayMode": "icons",
      "barIconScale": 1,
      "barItemSpacing": 0,
      "barItemPadding": 5,
      "barMarkerPosition": "after",
      "showBarSessionCounts": true,
      "showBarActiveMarker": true,
      "showBarDisabledMarker": true,
      "showBarPendingMarker": true,
      "showBarDegradedMarker": true,
      "barActiveMarkerIcon": "●",
      "barDisabledMarkerIcon": "⊘",
      "barPendingMarkerIcon": "…",
      "barDegradedMarkerIcon": "!",
      "activeColorRole": "bar-active",
      "inactiveColorRole": "muted",
      "disabledColorRole": "urgent",
      "disabledOpacity": 1,
      "statusMarkerMode": "symbols",
      "statePillStyle": "filled",
      "popupDensity": "comfortable",
      "popupLayout": "adaptive",
      "popupWidth": "standard",
      "popupItemScale": 1,
      "popupIdleOpacity": 0.72,
      "showStatePills": true,
      "showSessionCounts": true,
      "animatePending": true,
      "mutedColorRole": "urgent",
      "unmutedColorRole": "foreground",
      "showControls": true,
      "blockableKinds": ["camera", "screen-share", "location"],
      "itemColorRoles": {},
      "itemIdleVisibility": {},
      "itemStatusMarkerVisibility": {},
      "itemIdleOpacity": {},
      "itemLabels": {},
      "notifyOnActivity": true,
      "notifyOnStop": false,
      "notifyOnControlChanges": true,
      "notifyOnObserverHealth": false,
      "notificationKinds": ["microphone", "camera", "screen-share", "screen-recording", "location"],
      "idleOpacity": 0.45,
      "deduplicateApps": true,
      "excludedApps": ["cava"],
      "hiddenApps": [],
      "notificationSuppressedApps": [],
      "hiddenDevices": [],
      "notificationSuppressedDevices": [],
      "deviceLabels": {},
      "historyEnabled": false,
      "directDeviceMonitoring": false,
      "showInferredAttribution": true,
      "directDevicePollSeconds": 5,
      "popupMaxHeight": 620,
      "cameraKeywords": ["camera", "webcam", "v4l2", "libcamera", "kamera"],
      "screenShareKeywords": ["portal", "screencast", "screen cast", "screen share", "desktop capture", "monitor"],
      "locationPollSeconds": 15,
      "recordingPollSeconds": 2,
      "recordingBackend": "omarchy",
      "audioControlBackend": "auto",
      "screenshotBackend": "omarchy",
      "screenshotCustomCommand": "",
      "screenshotProcessName": "",
      "recordingProcessName": "",
      "recordingCustomStartCommand": "",
      "recordingCustomStopCommand": "",
      "icons": {
        "microphone": "󰍬",
        "audio-output": "󰓃",
        "camera": "󰄀",
        "screen-share": "󰍹",
        "screenshot": "󰹑",
        "screen-recording": "󰻂",
        "location": "󰋽"
      }
    },
    "schema": [
      {
        "key": "enabledKinds",
        "type": "multiselect",
        "label": "Monitored activity",
        "description": "Choose the privacy activity represented by this widget.",
        "defaultValue": ["microphone", "audio-output", "camera", "screen-share", "screenshot", "screen-recording", "location"],
        "options": [
          {"value": "microphone", "label": "Microphone"},
          {"value": "audio-output", "label": "Audio output"},
          {"value": "camera", "label": "Camera"},
          {"value": "screen-share", "label": "Screen sharing"},
          {"value": "screenshot", "label": "Screenshot"},
          {"value": "screen-recording", "label": "Screen recording"},
          {"value": "location", "label": "Location"}
        ]
      },
      {
        "key": "showIdle",
        "type": "boolean",
        "label": "Show idle activity icons",
        "description": "Keep enabled activity icons visible when they are not in use.",
        "defaultValue": false
      },
      {
        "key": "displayMode",
        "type": "enum",
        "label": "Bar presentation",
        "options": ["icons", "active-count", "active-only"],
        "defaultValue": "icons"
      },
      {
        "key": "barIconScale",
        "type": "number",
        "label": "Bar icon scale",
        "description": "Scale this widget's bar glyphs relative to the shell font size.",
        "min": 0.75,
        "max": 1.5,
        "step": 0.05,
        "defaultValue": 1
      },
      {
        "key": "barItemSpacing",
        "type": "integer",
        "label": "Bar item spacing",
        "description": "Space between privacy items in the bar.",
        "min": 0,
        "max": 12,
        "step": 1,
        "defaultValue": 0
      },
      {
        "key": "barItemPadding",
        "type": "integer",
        "label": "Bar item padding",
        "description": "Horizontal padding around each privacy item.",
        "min": 2,
        "max": 12,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "barMarkerPosition",
        "type": "enum",
        "label": "Bar marker position",
        "options": ["after", "before"],
        "defaultValue": "after"
      },
      {
        "key": "showBarSessionCounts",
        "type": "boolean",
        "label": "Show bar session counts",
        "description": "Append a count when multiple sessions share a bar item.",
        "defaultValue": true
      },
      {
        "key": "showBarActiveMarker",
        "type": "boolean",
        "label": "Show active bar marker",
        "description": "Show a status marker beside active privacy-device icons.",
        "defaultValue": true
      },
      {
        "key": "showBarDisabledMarker",
        "type": "boolean",
        "label": "Show disabled bar marker",
        "description": "Show a status marker beside disabled privacy-device icons.",
        "defaultValue": true
      },
      {
        "key": "showBarPendingMarker",
        "type": "boolean",
        "label": "Show verifying bar marker",
        "description": "Show a status marker while a privacy control is being verified.",
        "defaultValue": true
      },
      {
        "key": "showBarDegradedMarker",
        "type": "boolean",
        "label": "Show degraded bar marker",
        "description": "Show a status marker when monitoring is degraded.",
        "defaultValue": true
      },
      {
        "key": "barActiveMarkerIcon",
        "type": "string",
        "label": "Active bar marker icon",
        "defaultValue": "●"
      },
      {
        "key": "barDisabledMarkerIcon",
        "type": "string",
        "label": "Disabled bar marker icon",
        "defaultValue": "⊘"
      },
      {
        "key": "barPendingMarkerIcon",
        "type": "string",
        "label": "Verifying bar marker icon",
        "defaultValue": "…"
      },
      {
        "key": "barDegradedMarkerIcon",
        "type": "string",
        "label": "Degraded bar marker icon",
        "defaultValue": "!"
      },
      {
        "key": "activeColorRole",
        "type": "enum",
        "label": "Active theme color",
        "options": ["bar-active", "urgent", "accent", "foreground"],
        "defaultValue": "bar-active"
      },
    {
      "key": "inactiveColorRole",
        "type": "enum",
        "label": "Inactive theme color",
        "options": ["muted", "foreground", "accent"],
      "defaultValue": "muted"
    },
    {
      "key": "disabledColorRole",
      "type": "enum",
      "label": "Disabled theme color",
      "description": "Icon color for blocked or muted privacy controls.",
      "options": [
        "urgent",
        "muted",
        "accent",
        "foreground",
        "bar-active"
      ],
      "defaultValue": "urgent"
    },
    {
      "key": "disabledOpacity",
      "type": "number",
      "label": "Disabled icon opacity",
      "min": 0.25,
      "max": 1,
      "step": 0.05,
      "defaultValue": 1
    },
    {
      "key": "statusMarkerMode",
      "type": "enum",
      "label": "Bar status markers",
      "options": ["symbols", "letters", "custom", "off"],
      "defaultValue": "symbols"
    },
    {
      "key": "statePillStyle",
      "type": "enum",
      "label": "Popup state-pill style",
      "options": ["filled", "outline", "minimal"],
      "defaultValue": "filled"
    },
    {
      "key": "popupDensity",
      "type": "enum",
      "label": "Popup density",
      "options": ["comfortable", "compact"],
      "defaultValue": "comfortable"
    },
    {
      "key": "popupLayout",
      "type": "enum",
      "label": "Popup layout",
      "description": "Use a list, a two-column grid, or adapt the layout when the popup is wide.",
      "options": ["adaptive", "list", "grid"],
      "defaultValue": "adaptive"
    },
    {
      "key": "popupWidth",
      "type": "enum",
      "label": "Popup width",
      "options": ["narrow", "standard", "wide"],
      "defaultValue": "standard"
    },
    {
      "key": "popupItemScale",
      "type": "number",
      "label": "Popup item scale",
      "description": "Scale activity-row icons and text without changing the rest of the popup.",
      "min": 0.85,
      "max": 1.3,
      "step": 0.05,
      "defaultValue": 1
    },
    {
      "key": "popupIdleOpacity",
      "type": "number",
      "label": "Popup idle visibility",
      "description": "Keep inactive devices readable while preserving active-state emphasis.",
      "min": 0.45,
      "max": 1,
      "step": 0.05,
      "defaultValue": 0.72
    },
    {
      "key": "showStatePills",
      "type": "boolean",
      "label": "Show popup state pills",
      "defaultValue": true
    },
    {
      "key": "showSessionCounts",
      "type": "boolean",
      "label": "Show multi-session counts",
      "defaultValue": true
    },
    {
      "key": "animatePending",
      "type": "boolean",
      "label": "Animate pending verification",
      "defaultValue": true
    },
      {
        "key": "mutedColorRole",
        "type": "enum",
        "label": "Muted theme color",
        "description": "Icon color for muted microphone and audio output controls.",
        "options": [
          "urgent",
          "muted",
          "bar-active",
          "accent",
          "foreground"
        ],
        "defaultValue": "urgent"
      },
      {
        "key": "unmutedColorRole",
        "type": "enum",
        "label": "Unmuted theme color",
        "description": "Icon color for available microphone and audio output controls.",
        "options": [
          "foreground",
          "bar-active",
          "accent",
          "muted",
          "urgent"
        ],
        "defaultValue": "foreground"
      },
      {
        "key": "showControls",
        "type": "boolean",
        "label": "Show privacy controls",
        "description": "Make controllable activity rows clickable and show their inline switches.",
        "defaultValue": true
      },
      {
        "key": "notifyOnActivity",
        "type": "boolean",
        "label": "Notify when privacy activity starts",
        "defaultValue": true
      },
      {
        "key": "notifyOnStop",
        "type": "boolean",
        "label": "Notify when privacy activity stops",
        "description": "Include the session duration in stop notifications.",
        "defaultValue": false
      },
      {
        "key": "notifyOnControlChanges",
        "type": "boolean",
        "label": "Notify after privacy control changes",
        "defaultValue": true
      },
      {
        "key": "notifyOnObserverHealth",
        "type": "boolean",
        "label": "Notify on observer health changes",
        "description": "Notify on degraded and recovered transitions with rate limiting.",
        "defaultValue": false
      },
      {
        "key": "notificationKinds",
        "type": "multiselect",
        "label": "Activity notifications",
        "description": "Choose activity that should produce start notifications.",
        "defaultValue": ["microphone", "camera", "screen-share", "screen-recording", "location"],
        "options": [
          {"value": "microphone", "label": "Microphone"},
          {"value": "audio-output", "label": "Audio output"},
          {"value": "camera", "label": "Camera"},
          {"value": "screen-share", "label": "Screen sharing"},
          {"value": "screenshot", "label": "Screenshot"},
          {"value": "screen-recording", "label": "Screen recording"},
          {"value": "location", "label": "Location"}
        ]
      },
      {
        "key": "blockableKinds",
        "type": "multiselect",
        "label": "Preventative controls",
        "description": "Choose devices that can be proactively allowed or blocked.",
        "defaultValue": ["camera", "screen-share", "location"],
        "options": [
          {"value": "camera", "label": "Camera"},
          {"value": "screen-share", "label": "Screen sharing"},
          {"value": "location", "label": "Location"}
        ]
      },
      {
        "key": "idleOpacity",
        "type": "number",
        "label": "Idle icon opacity",
        "min": 0.1,
        "max": 1,
        "step": 0.05,
        "defaultValue": 0.45
      },
      {
        "key": "deduplicateApps",
        "type": "boolean",
        "label": "Deduplicate applications",
        "defaultValue": true
      },
      {
        "key": "excludedApps",
        "type": "string-list",
        "label": "Ignored applications",
        "description": "Case-insensitive exact or substring matches, such as cava.",
        "defaultValue": ["cava"]
      },
      {
        "key": "hiddenApps",
        "type": "string-list",
        "label": "Hidden applications",
        "description": "Hide matching application sessions from the bar while retaining alerts and diagnostics.",
        "defaultValue": []
      },
      {
        "key": "notificationSuppressedApps",
        "type": "string-list",
        "label": "Applications without alerts",
        "description": "Suppress start and stop notifications for exact application names without hiding their activity.",
        "defaultValue": []
      },
      {
        "key": "historyEnabled",
        "type": "boolean",
        "label": "Keep recent activity",
        "description": "Retain local metadata for up to seven days or 100 completed sessions. Disabling this deletes stored history.",
        "defaultValue": false
      },
      {
        "key": "directDeviceMonitoring",
        "type": "boolean",
        "label": "Enhanced direct-device monitoring",
        "description": "Also inspect same-user open handles for V4L2 cameras and ALSA capture devices. No media is opened or read.",
        "defaultValue": false
      },
      {
        "key": "directDevicePollSeconds",
        "type": "integer",
        "label": "Direct-device refresh interval",
        "description": "How often enhanced monitoring scans same-user open device handles.",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "showInferredAttribution",
        "type": "boolean",
        "label": "Show inferred attribution",
        "description": "Display application and device names from heuristic observers. Activity remains visible when this is disabled.",
        "defaultValue": true
      },
      {
        "key": "popupMaxHeight",
        "type": "integer",
        "label": "Popup maximum height",
        "description": "Cap the activity and settings popup height before it becomes scrollable.",
        "min": 360,
        "max": 900,
        "step": 20,
        "defaultValue": 620
      },
      {
        "key": "cameraKeywords",
        "type": "string-list",
        "label": "Camera classification keywords",
        "defaultValue": ["camera", "webcam", "v4l2", "libcamera", "kamera"]
      },
      {
        "key": "screenShareKeywords",
        "type": "string-list",
        "label": "Screen-share classification keywords",
        "defaultValue": ["portal", "screencast", "screen cast", "screen share", "desktop capture", "monitor"]
      },
      {
        "key": "locationPollSeconds",
        "type": "integer",
        "label": "Location refresh interval",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "recordingPollSeconds",
        "type": "integer",
        "label": "Recorder refresh interval",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 2
      },
      {
        "key": "recordingBackend",
        "type": "enum",
        "label": "Screen-recording backend",
        "description": "Follow Omarchy's recorder, explicitly use gpu-screen-recorder, use wf-recorder, or provide custom commands.",
        "options": ["omarchy", "gpu-screen-recorder", "wf-recorder", "custom"],
        "defaultValue": "omarchy"
      },
      {
        "key": "audioControlBackend",
        "type": "enum",
        "label": "Audio control backend",
        "description": "Auto prefers pactl and falls back to wpctl. PipeWire activity detection is unchanged.",
        "options": ["auto", "pactl", "wpctl"],
        "defaultValue": "auto"
      },
      {
        "key": "screenshotBackend",
        "type": "enum",
        "label": "Screenshot backend",
        "description": "Use Omarchy capture, direct Grim region capture, Grim with Satty annotation, or a custom command.",
        "options": ["omarchy", "grim", "grim-satty", "hyprshot", "flameshot", "custom"],
        "defaultValue": "omarchy"
      },
      {
        "key": "screenshotCustomCommand",
        "type": "string",
        "label": "Custom screenshot command",
        "defaultValue": ""
      },
      {
        "key": "screenshotProcessName",
        "type": "string",
        "label": "Custom screenshot process",
        "description": "Optional process command substring used while a custom screenshot UI is active.",
        "defaultValue": ""
      },
      {
        "key": "recordingProcessName",
        "type": "string",
        "label": "Custom recorder process",
        "description": "Process command substring used to detect activity for a custom recording backend.",
        "defaultValue": ""
      },
      {
        "key": "recordingCustomStartCommand",
        "type": "string",
        "label": "Custom recorder start command",
        "defaultValue": ""
      },
      {
        "key": "recordingCustomStopCommand",
        "type": "string",
        "label": "Custom recorder stop command",
        "defaultValue": ""
      },
      {"key": "icons.microphone", "type": "string", "label": "Microphone icon"},
      {"key": "icons.audio-output", "type": "string", "label": "Audio output icon"},
      {"key": "icons.camera", "type": "string", "label": "Camera icon"},
      {"key": "icons.screen-share", "type": "string", "label": "Screen-share icon"},
      {"key": "icons.screenshot", "type": "string", "label": "Screenshot icon"},
      {"key": "icons.screen-recording", "type": "string", "label": "Screen-recording icon"},
      {"key": "icons.location", "type": "string", "label": "Location icon"}
    ]
  }
}
