#!/usr/bin/env python3
"""Validate and copy the plugin's bounded, privacy-aware diagnostic payload."""

import json
import os
import shutil
import subprocess
import sys


MAX_BYTES = 131072


def reject_constant(value: str):
    raise ValueError(f"invalid number: {value}")


def main() -> int:
    if len(sys.argv) != 2 or len(sys.argv[1].encode()) > MAX_BYTES:
        return 2
    try:
        payload = json.loads(sys.argv[1], parse_constant=reject_constant)
        if not isinstance(payload, dict) or payload.get("version") != 1:
            return 2
    except (ValueError, json.JSONDecodeError):
        return 2
    clipboard = shutil.which("wl-copy")
    if not clipboard:
        return 1
    try:
        return subprocess.run(
            [os.path.realpath(clipboard)], input=json.dumps(payload, separators=(",", ":")),
            text=True, check=False, timeout=5,
        ).returncode
    except (OSError, subprocess.SubprocessError):
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
