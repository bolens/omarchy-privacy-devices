#!/usr/bin/env bash

set -Eeuo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

capture_failed=false
failure_line=0
current_checkpoint="preflight"
capture_dir=""
on_capture_error() {
  failure_line=$1
  capture_failed=true
  printf 'Capture failed at line %s during %s.\n' "$failure_line" "$current_checkpoint" >&2
}
trap 'on_capture_error "$LINENO"' ERR

plugin_id="io.github.bolens.privacy-devices"
monitor=""
capture_workspace=""
verify_only=false
report_file=""
panel_width=500
panel_side_padding=16

usage() {
  cat <<'EOF'
Usage: scripts/capture-screenshots [--monitor NAME] [--workspace ID] [--verify] [--report FILE]

Capture the live plugin on an empty workspace, update repository screenshots,
and restore the monitor's original workspace. By default, the monitor containing
the launching focused window is selected; --monitor overrides that choice.

--verify performs the complete capture and restoration flow without publishing
repository assets, then fails if any protected state or the shell PID changed.
EOF
}

while (($#)); do
  case "$1" in
    --monitor) monitor=${2:-}; shift 2 ;;
    --workspace) capture_workspace=${2:-}; shift 2 ;;
    --verify) verify_only=true; shift ;;
    --report) report_file=${2:-}; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

for command in qs hyprctl jq grim magick wtype omarchy python3 flock base64 find sha256sum ps; do
  command -v "$command" >/dev/null || { printf 'Missing required command: %s\n' "$command" >&2; exit 1; }
done
if [[ $verify_only == false ]]; then
  command -v pngquant >/dev/null || { printf 'Missing required command: pngquant\n' >&2; exit 1; }
fi

lock_file="${XDG_RUNTIME_DIR:-/tmp}/privacy-devices-screenshots-${UID}.lock"
exec 9>"$lock_file"
flock -n 9 || { printf 'Another screenshot capture is already running.\n' >&2; exit 1; }

monitor_json=$(hyprctl monitors -j)
cursor_json=$(hyprctl cursorpos -j)
active_window_json=$(hyprctl activewindow -j)
if [[ -z $monitor ]]; then
  client_json=$(hyprctl clients -j)
  launcher_pids=()
  launcher_pid=$PPID
  while [[ $launcher_pid =~ ^[1-9][0-9]*$ ]] && ((launcher_pid > 1)); do
    launcher_pids+=("$launcher_pid")
    launcher_pid=$(ps -o ppid= -p "$launcher_pid" 2>/dev/null | tr -d ' ' || true)
  done
  launcher_pid_json=$(printf '%s\n' "${launcher_pids[@]}" | jq -s 'map(select(length > 0) | tonumber)')
  launcher_monitor=$(jq -r --argjson pids "$launcher_pid_json" \
    '[ $pids[] as $pid | .[] | select(.pid == $pid) | .monitor ][0] // -1' <<<"$client_json")
  monitor_state=$(jq -cn --argjson active "$active_window_json" --argjson monitors "$monitor_json" --argjson cursor "$cursor_json" \
    --argjson launcher "$launcher_monitor" \
    '{launcher:{monitor:$launcher},active:$active,monitors:$monitors,cursor:$cursor}')
  monitor=$(scripts/select-capture-monitor "$monitor_state") || {
    printf 'Could not determine the launch monitor; pass --monitor NAME.\n' >&2
    exit 2
  }
fi
[[ $monitor =~ ^[A-Za-z0-9_.-]+$ ]] || { printf 'Invalid monitor name: %s\n' "$monitor" >&2; exit 2; }

monitor_width=$(jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .width' <<<"$monitor_json")
monitor_height=$(jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .height' <<<"$monitor_json")
monitor_x=$(jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .x' <<<"$monitor_json")
monitor_y=$(jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .y' <<<"$monitor_json")
original_workspace=$(jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .activeWorkspace.id' <<<"$monitor_json")
original_cursor_x=$(jq -r '.x' <<<"$cursor_json")
original_cursor_y=$(jq -r '.y' <<<"$cursor_json")
[[ $monitor_width =~ ^[1-9][0-9]*$ && $monitor_height =~ ^[1-9][0-9]*$ && $monitor_x =~ ^-?[0-9]+$ && $monitor_y =~ ^-?[0-9]+$ && $original_cursor_x =~ ^-?[0-9]+$ && $original_cursor_y =~ ^-?[0-9]+$ && $original_workspace =~ ^-?[0-9]+$ ]] || {
  printf 'Monitor is not active: %s\n' "$monitor" >&2
  exit 2
}

if [[ -z $capture_workspace ]]; then
  capture_workspace=$(jq -r --arg monitor "$monitor" '
    [.[] | select(.monitor == $monitor and (.id > 0)) | .id] | sort | reverse | .[0] // empty
  ' < <(hyprctl workspaces -j))
fi
[[ $capture_workspace =~ ^[1-9][0-9]*$ ]] || { printf 'Capture workspace must be a positive integer.\n' >&2; exit 2; }
printf '{"pid":%s,"monitor":"%s","workspace":%s}\n' "$$" "$monitor" "$capture_workspace" >&9

window_count=$(jq -r --argjson workspace "$capture_workspace" '[.[] | select(.workspace.id == $workspace)] | length' < <(hyprctl clients -j))
((window_count == 0)) || {
  printf 'Workspace %s is not empty; choose another with --workspace.\n' "$capture_workspace" >&2
  exit 2
}

shell_pid=""
initial_shell_pid=""
widget_x=""
widget_width=""
panel_capture_x=""

wait_for_shell() {
  local attempt candidate shell_reply history_reply
  for attempt in {1..40}; do
    while read -r candidate; do
      [[ $candidate =~ ^[1-9][0-9]*$ ]] || continue
      shell_reply=$(qs ipc --pid "$candidate" call shell ping 2>/dev/null || true)
      history_reply=$(qs ipc --pid "$candidate" call privacy-devices historyEnabled 2>/dev/null || true)
      if [[ $shell_reply == ok && $history_reply =~ ^(true|false)$ ]]; then
        shell_pid=$candidate
        return 0
      fi
    done < <(qs list --all | awk '/Process ID:/ { print $3 }' | sort -rn)
    sleep 0.25
  done
  printf 'Omarchy Shell did not become IPC-ready.\n' >&2
  return 1
}

focus_capture_workspace() {
  local attempt focused workspace
  # Moving the pointer is the only monitor-selection path that is independent
  # of optional workspace-routing plugins. Do not switch workspaces until the
  # compositor confirms that the requested output owns focus.
  hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = $((monitor_x + monitor_width / 2)), y = $((monitor_y + monitor_height / 2)) }))" >/dev/null
  for attempt in {1..20}; do
    focused=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .focused')
    [[ $focused == true ]] && break
    sleep 0.1
  done
  [[ $focused == true ]] || {
    printf 'Could not focus capture monitor %s.\n' "$monitor" >&2
    return 1
  }
  hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = \"$capture_workspace\" }))" >/dev/null
  for attempt in {1..20}; do
    focused=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .focused')
    workspace=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .activeWorkspace.id')
    [[ $focused == true && $workspace == "$capture_workspace" ]] && return 0
    sleep 0.1
  done
  printf 'Could not focus %s workspace %s.\n' "$monitor" "$capture_workspace" >&2
  return 1
}

park_capture_cursor() {
  hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = $((monitor_x + monitor_width / 2)), y = $((monitor_y + monitor_height / 2)) }))" >/dev/null
}

restore_cursor() {
  hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = $original_cursor_x, y = $original_cursor_y }))" >/dev/null 2>&1
}

restore_original_workspace() {
  local attempt focused workspace
  hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = $((monitor_x + monitor_width / 2)), y = $((monitor_y + monitor_height / 2)) }))" >/dev/null 2>&1 || return 1
  for attempt in {1..20}; do
    focused=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .focused')
    [[ $focused == true ]] && break
    sleep 0.1
  done
  [[ $focused == true ]] || return 1
  hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = \"$original_workspace\" }))" >/dev/null 2>&1 || return 1
  for attempt in {1..20}; do
    focused=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .focused')
    workspace=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .activeWorkspace.id')
    [[ $focused == true && $workspace == "$original_workspace" ]] && return 0
    sleep 0.1
  done
  printf 'Could not restore %s workspace %s.\n' "$monitor" "$original_workspace" >&2
  return 1
}

resolve_geometry() {
  local attempt geometry widget_row
  for attempt in {1..40}; do
    check_capture_environment || return 1
    geometry=$(qs ipc --pid "$shell_pid" call shell debugBarGeometry 2>/dev/null || true)
    widget_row=$(jq -c --arg id "$plugin_id" --argjson width "$monitor_width" '
      [.[] | select(.id == $id and .visible and .width > 0)]
      | sort_by((((.x + (.width / 2)) - ($width / 2)) | fabs))
      | .[0]
    ' <<<"${geometry:-[]}" 2>/dev/null || true)
    widget_x=$(jq -r '.x // empty' <<<"${widget_row:-null}")
    widget_width=$(jq -r '.width // empty' <<<"${widget_row:-null}")
    if [[ $widget_x =~ ^[0-9]+$ && $widget_width =~ ^[1-9][0-9]*$ ]]; then
      panel_capture_x=$((widget_x + widget_width / 2 - panel_width / 2 - panel_side_padding))
      if ((panel_capture_x >= 0 && panel_capture_x + panel_width + panel_side_padding * 2 <= monitor_width)); then return 0; fi
    fi
    sleep 0.25
  done
  printf 'Could not resolve live bar geometry for %s on %s.\n' "$plugin_id" "$monitor" >&2
  return 1
}

capture_has_content() {
  local image=$1 colors
  colors=$(magick "$image" -format '%k' info: 2>/dev/null || true)
  [[ $colors =~ ^[0-9]+$ ]] && ((colors >= 8))
}

capture_has_panel() {
  local image=$1 light_fraction
  capture_has_content "$image" || return 1
  light_fraction=$(magick "$image" -crop '400x80+66+30' +repage -colorspace gray -threshold 35% -format '%[fx:mean]' info: 2>/dev/null || true)
  [[ $light_fraction =~ ^[0-9]+([.][0-9]+)?$ ]] && awk -v value="$light_fraction" 'BEGIN { exit !(value > 0.01 && value < 0.70) }'
}

capture_monitor_frame() {
  local destination=$1 attempt
  for attempt in {1..4}; do
    focus_capture_workspace || return 1
    if grim -o "$monitor" "$destination"; then return 0; fi
    sleep 0.25
  done
  printf 'Could not capture monitor %s after four attempts.\n' "$monitor" >&2
  return 1
}

expect_ipc_reply() {
  local expected=$1 reply
  shift
  reply=$(qs ipc --pid "$shell_pid" call "$@" 2>/dev/null || true)
  [[ $reply == "$expected" ]] || {
    printf 'Expected IPC view %s, received %s.\n' "$expected" "${reply:-no reply}" >&2
    return 1
  }
}

wait_for_panel_presentation() {
  local mode=$1 page=${2:-} section=${3:-} attempt state expected_view
  case "$mode" in
    settings|settings-section) expected_view=settings ;;
    device) expected_view=device ;;
    history|history-disabled) expected_view=history ;;
    activity) expected_view=activity ;;
    *) return 1 ;;
  esac
  for attempt in {1..40}; do
    check_capture_environment || return 1
    state=$(qs ipc --pid "$shell_pid" call privacy-devices-capture-v2 presentation "$capture_owner" "$monitor" 2>/dev/null || true)
    if jq -e --arg view "$expected_view" --arg page "$page" --arg section "$section" '
      .opened == true and .ready == true and .view == $view
      and ($view != "device" or .argument == $page)
      and ($view != "settings" or (.settingsPage == $page and .settingsSection == $section))
    ' <<<"${state:-null}" >/dev/null 2>&1; then return 0; fi
    sleep 0.1
  done
  printf 'Panel did not acknowledge %s view on %s.\n' "$expected_view" "$monitor" >&2
  return 1
}

wait_for_panel_closed() {
  local attempt state
  for attempt in {1..30}; do
    state=$(qs ipc --pid "$shell_pid" call privacy-devices-capture-v2 presentation "$capture_owner" "$monitor" 2>/dev/null || true)
    if jq -e '.opened != true' <<<"${state:-null}" >/dev/null 2>&1; then return 0; fi
    sleep 0.1
  done
  printf 'Panel on %s did not acknowledge closing.\n' "$monitor" >&2
  return 1
}

capture_panel() {
  local name=$1 mode=$2 page=${3:-} height=${4:-660} section=${5:-} crop_top=${6:-20} attempt
  for attempt in {1..4}; do
    : "$attempt"
    check_capture_environment || return 1
    focus_capture_workspace || return 1
    # The bar routes a summon to an already-open copy before considering the
    # focused monitor. Close that copy first so every capture opens on the
    # monitor and workspace selected above instead of following stale UI state.
    expect_ipc_reply ok privacy-devices-capture-v2 closePanel "$capture_owner" "$monitor" || continue
    wait_for_panel_closed || continue
    case "$mode" in
      history) expect_ipc_reply history privacy-devices-capture-v2 openPanel "$capture_owner" "$monitor" "$mode" "$page" "$section" ;;
      history-disabled)
        expect_ipc_reply history-disabled privacy-devices-capture-v2 openPanel "$capture_owner" "$monitor" "$mode" "$page" "$section"
        capture_preview_state=$(qs ipc --pid "$shell_pid" call privacy-devices-capture-v2 state "$capture_owner" 2>/dev/null || true)
        ;;
      settings) expect_ipc_reply "$page" privacy-devices-capture-v2 openPanel "$capture_owner" "$monitor" "$mode" "$page" "$section" ;;
      settings-section) expect_ipc_reply "$page#$section" privacy-devices-capture-v2 openPanel "$capture_owner" "$monitor" "$mode" "$page" "$section" ;;
      activity) expect_ipc_reply activity privacy-devices-capture-v2 openPanel "$capture_owner" "$monitor" "$mode" "$page" "$section" ;;
      device) expect_ipc_reply activity privacy-devices-capture-v2 openPanel "$capture_owner" "$monitor" "$mode" "${page:-microphone}" "$section" ;;
    esac
    wait_for_panel_presentation "$mode" "$page" "$section" || continue
    resolve_geometry || return 1
    capture_monitor_frame "$capture_dir/$name-full.png"
    magick "$capture_dir/$name-full.png" \
      -crop "$((panel_width + panel_side_padding * 2))x${height}+${panel_capture_x}+${crop_top}" \
      +repage "$capture_dir/$name.png"
    if capture_has_panel "$capture_dir/$name.png"; then return 0; fi
  done
  printf 'Could not capture populated %s view after four attempts.\n' "$name" >&2
  return 1
}

wait_for_shell
initial_shell_pid=$shell_pid
capture_owner=$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
[[ $(qs ipc --pid "$shell_pid" call privacy-devices-capture-v2 protocol 2>/dev/null || true) == 2 ]] || {
  printf 'Installed Privacy Devices capture protocol is unavailable or outdated.\n' >&2
  exit 1
}

recovery_root="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-privacy-devices/captures"
mkdir -p "$recovery_root"
chmod 0700 "$recovery_root"
scripts/prune-capture-recovery "$recovery_root" 7
capture_dir=$(mktemp -d "$recovery_root/capture.XXXXXX")
publish_dir="$capture_dir/publish"
if [[ $verify_only == false ]]; then mkdir -p "$publish_dir/docs"; fi
settings_file="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
[[ -f $settings_file ]] || { printf 'Omarchy Shell settings not found: %s\n' "$settings_file" >&2; exit 1; }
settings_snapshot="$capture_dir/shell.json"
history_snapshot="$capture_dir/history.json"
cp -- "$settings_file" "$settings_snapshot"
./privacy-history load >"$history_snapshot"
restored=false
preview_active=false
capture_preview_state=""
notification_visible=false
notification_summary="Privacy activity started · Screenshot example"
dnd_state=""
original_dnd_state=""
dnd_changed=false
settings_restore_status="untouched"
history_restore_status="untouched"
dnd_restore_status="unchanged"
workspace_restore_status="pending"
shell_identity_status="unchanged"
plugin_root="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$plugin_id"
plugin_fingerprint=$(scripts/capture-plugin-fingerprint "$plugin_root")
check_capture_environment() {
  scripts/capture-environment-guard "$initial_shell_pid" "$capture_owner" "$plugin_root" "$plugin_fingerprint" "$preview_active" || return 1
  if [[ $preview_active == true ]]; then
    local current_preview_state
    current_preview_state=$(qs ipc --pid "$shell_pid" call privacy-devices-capture-v2 state "$capture_owner" 2>/dev/null || true)
    [[ $current_preview_state == "$capture_preview_state" ]] || {
      printf '%s\n' "$capture_preview_state" >"$capture_dir/bar-state-baseline.json"
      printf '%s\n' "$current_preview_state" >"$capture_dir/bar-state-current.json"
      printf 'Capture preview state changed during the workflow.\n' >&2
      return 1
    }
  fi
}
capture_bar_signature() {
  local name=${1:-current} full crop geometry row sample_x sample_width
  geometry=$(qs ipc --pid "$shell_pid" call shell debugBarGeometry 2>/dev/null || true)
  row=$(jq -c --arg id "$plugin_id" --argjson width "$monitor_width" '
    [.[] | select(.id == $id and .visible and .width > 0)]
    | sort_by((((.x + (.width / 2)) - ($width / 2)) | fabs)) | .[0]
  ' <<<"${geometry:-[]}")
  sample_x=$(jq -r '.x // empty' <<<"${row:-null}")
  sample_width=$(jq -r '.width // empty' <<<"${row:-null}")
  [[ $sample_x =~ ^[0-9]+$ && $sample_width =~ ^[1-9][0-9]*$ ]] || return 1
  full="$capture_dir/bar-${name}-full.png"
  crop="$capture_dir/bar-${name}.png"
  grim -o "$monitor" "$full"
  magick "$full" -crop "${sample_width}x50+${sample_x}+0" +repage "$crop"
  magick "$crop" -format '%#' info:
}
capture_checkpoint() {
  local checkpoint=$1
  current_checkpoint=$checkpoint
  check_capture_environment || return 1
  if [[ ${PRIVACY_CAPTURE_TESTING:-0} == 1 && ${PRIVACY_CAPTURE_FAIL_AT:-} == "$checkpoint" ]]; then
    printf 'Injected capture failure at %s.\n' "$checkpoint" >&2
    return 1
  fi
}
close_capture_notification() {
  if [[ $notification_visible == true ]]; then
    qs ipc --pid "$shell_pid" call notifications dismiss "$notification_summary" >/dev/null 2>&1 || true
    notification_visible=false
  fi
}
set_capture_preview() {
  local payload reply settings
  settings=$(jq -cn '{privacyModes:[
    {name:"Meeting",controls:{microphone:true,"audio-output":true,camera:true,"screen-share":false,location:false}},
    {name:"Travel",controls:{microphone:false,"audio-output":true,camera:false,"screen-share":false,location:false}}
  ]}')
  payload=$(jq -cn --arg owner "$capture_owner" --argjson settings "$settings" --argjson history "$history_samples" --argjson sessions "$activity_samples" '{owner:$owner,settings:$settings,history:$history,sessions:$sessions}' | base64 -w 0)
  reply=$(qs ipc --pid "$shell_pid" call privacy-devices-capture-v2 beginCapture "$payload" 2>/dev/null || true)
  [[ $reply == ok ]] || { printf 'Could not activate in-memory capture preview.\n' >&2; return 1; }
  preview_active=true
  capture_preview_state=$(qs ipc --pid "$shell_pid" call privacy-devices-capture-v2 state "$capture_owner" 2>/dev/null || true)
  [[ $capture_preview_state != denied && -n $capture_preview_state ]] || { printf 'Could not snapshot capture preview state.\n' >&2; return 1; }
}
end_capture_preview() {
  local reply
  [[ $preview_active == true ]] || return 0
  reply=$(qs ipc --pid "$shell_pid" call privacy-devices-capture-v2 endCapture "$capture_owner" 2>/dev/null || true)
  [[ $reply == ok ]] || { printf 'Could not clear in-memory capture preview.\n' >&2; return 1; }
  preview_active=false
}
restore_dnd() {
  local actual reply
  [[ $dnd_changed == true ]] || return 0
  reply=$(qs ipc --pid "$shell_pid" call notifications setDnd "$dnd_state" 2>/dev/null || true)
  actual=$(qs ipc --pid "$shell_pid" call notifications isDnd 2>/dev/null || true)
  [[ $reply == ok && $actual == "$dnd_state" ]] || {
    printf 'Could not restore DND state to %s.\n' "$dnd_state" >&2
    return 1
  }
  dnd_state=""
  dnd_changed=false
  dnd_restore_status="ok"
}
report_restoration() {
  [[ $shell_pid == "$initial_shell_pid" ]] || shell_identity_status="replaced:$initial_shell_pid->$shell_pid"
  printf 'Restoration: settings=%s history=%s dnd=%s workspace=%s shell=%s\n' \
    "$settings_restore_status" "$history_restore_status" "$dnd_restore_status" \
    "$workspace_restore_status" "$shell_identity_status"
}
write_failure_report() {
  local recovery_report destination
  [[ -n $capture_dir && -d $capture_dir ]] || return 0
  recovery_report="$capture_dir/verification.json"
  jq -n --arg mode "$([[ $verify_only == true ]] && printf verify || printf publish)" \
    --arg checkpoint "$current_checkpoint" --argjson line "$failure_line" \
    --arg recoveryPath "$capture_dir" \
    '{version:1,result:"failed",mode:$mode,checkpoint:$checkpoint,line:$line,recoveryPath:$recoveryPath}' >"$recovery_report"
  if [[ -n $report_file ]]; then
    destination=$report_file
    cp -- "$recovery_report" "$destination"
    printf 'Failure report: %s\n' "$destination" >&2
  fi
}
restore_desktop() {
  local restore_failed=false
  if [[ $restored == false ]]; then
    close_capture_notification
    wait_for_shell || restore_failed=true
    restore_dnd || restore_failed=true
    end_capture_preview || restore_failed=true
    qs ipc --pid "$shell_pid" call shell hide "$plugin_id" >/dev/null 2>&1 || true
    if restore_original_workspace; then workspace_restore_status="ok"; else restore_failed=true; fi
    restore_cursor || restore_failed=true
    [[ $restore_failed == false ]] && restored=true
    report_restoration
  fi
  [[ $restore_failed == false ]]
}
cleanup_capture() {
  local cleanup_failed=false
  trap - ERR
  restore_desktop || cleanup_failed=true
  if [[ $capture_failed == true || $cleanup_failed == true ]]; then
    write_failure_report || true
    printf 'Preserved recovery snapshot at %s.\n' "$capture_dir" >&2
  else
    rm -rf -- "$capture_dir"
  fi
  [[ $cleanup_failed == false ]]
}
trap cleanup_capture EXIT INT TERM

capture_now=$(python3 -c 'import time; print(time.time_ns() // 1_000_000)')
history_samples=$(jq -cn --argjson now "$capture_now" '[
  {id:"capture-firefox-microphone",kind:"microphone",application:"Firefox",device:"USB microphone",source:"pipewire",confidence:"confirmed",startedAt:($now-185000),endedAt:($now-5000),durationMs:180000},
  {id:"capture-obs-camera",kind:"camera",application:"OBS Studio",device:"Integrated camera",source:"pipewire",confidence:"confirmed",startedAt:($now-3900000),endedAt:($now-300000),durationMs:3600000},
  {id:"capture-chromium-screen",kind:"screen-share",application:"Chromium",device:"Desktop portal",source:"pipewire",confidence:"confirmed",startedAt:($now-8700000),endedAt:($now-7800000),durationMs:900000}
]')
activity_samples=$(jq -cn --argjson now "$capture_now" '[
  {kind:"microphone",application:"Firefox",device:"USB microphone",source:"pipewire",confidence:"confirmed",startedAt:($now-26000)},
  {kind:"audio-output",application:"Music Player",device:"Desktop audio",source:"pipewire",confidence:"confirmed",startedAt:($now-26000)},
  {kind:"screenshot",application:"Screenshot tool",device:"Desktop",source:"process-probe",confidence:"inferred",startedAt:($now-3000)}
]')
set_capture_preview
capture_checkpoint preview-enabled
focus_capture_workspace
park_capture_cursor
resolve_geometry

capture_panel general settings general 660
capture_preview_state=$(qs ipc --pid "$shell_pid" call privacy-devices-capture-v2 state "$capture_owner" 2>/dev/null || true)
capture_bar_signature baseline >/dev/null
for page in alerts monitoring; do capture_panel "$page" settings "$page" 660; done
capture_panel monitoring-private settings-section monitoring 395 private-data 70
capture_panel monitoring-health settings-section monitoring 290 observer-health 390
capture_panel device device microphone 660
capture_panel activity activity "" 500
capture_panel appearance settings appearance 660
capture_panel history history "" 660
capture_panel history-disabled history-disabled "" 240

expect_ipc_reply ok privacy-devices-capture-v2 closePanel "$capture_owner" "$monitor"
wait_for_panel_closed
resolve_geometry
capture_monitor_frame "$capture_dir/bar-full.png"

dnd_state=$(qs ipc --pid "$shell_pid" call notifications isDnd)
original_dnd_state=$dnd_state
if [[ $dnd_state == on ]]; then
  qs ipc --pid "$shell_pid" call notifications setDnd off >/dev/null
  dnd_changed=true
fi
notification_x=$((monitor_width - 428))
((notification_x >= 0)) || { printf 'Monitor is too narrow for notification capture.\n' >&2; exit 1; }
capture_monitor_frame "$capture_dir/notification-baseline-full.png"
magick "$capture_dir/notification-baseline-full.png" -crop "420x160+${notification_x}+30" \
  +repage "$capture_dir/notification-baseline.png"
omarchy notification send --app-name "Privacy Devices" \
  --icon firefox --urgency normal --expire-time 15000 \
  "$notification_summary" "Firefox: Microphone"
notification_visible=true
notification_changed=false
for attempt in {1..40}; do
  grim -o "$monitor" "$capture_dir/notification-full.png"
  magick "$capture_dir/notification-full.png" -crop "420x160+${notification_x}+30" \
    +repage "$capture_dir/notification.png"
  changed_pixels=$(magick compare -metric AE -fuzz 3% "$capture_dir/notification-baseline.png" \
    "$capture_dir/notification.png" null: 2>&1 || true)
  if [[ $changed_pixels =~ ^[0-9]+$ ]] && ((changed_pixels >= 500)); then notification_changed=true; break; fi
  sleep 0.1
done
[[ $notification_changed == true ]] || { printf 'Notification did not become visibly ready on %s.\n' "$monitor" >&2; exit 1; }
dismiss_result=$(qs ipc --pid "$shell_pid" call notifications dismiss "$notification_summary")
if [[ $dismiss_result != ok ]]; then
  printf 'Capture notification dismissal was unavailable; it will expire automatically.\n' >&2
fi
notification_visible=false
restore_dnd

magick "$capture_dir/bar-full.png" -crop "${widget_width}x50+${widget_x}+0" +repage "$capture_dir/bar.png"

validate_capture() {
  local image=$1 expected_width=$2 expected_height=$3 actual
  if ! capture_has_content "$image"; then
    printf 'Capture has too little visual content: %s\n' "$image" >&2
    exit 1
  fi
  actual=$(magick identify -format '%wx%h' "$image")
  if [[ $actual != "${expected_width}x${expected_height}" ]]; then
    printf 'Capture dimensions do not match its view: %s expected=%sx%s actual=%s\n' "$image" "$expected_width" "$expected_height" "$actual" >&2
    exit 1
  fi
}
validate_capture "$capture_dir/activity.png" 532 500
validate_capture "$capture_dir/device.png" 532 660
validate_capture "$capture_dir/bar.png" "$widget_width" 50
validate_capture "$capture_dir/notification.png" 420 160
validate_capture "$capture_dir/history.png" 532 660
validate_capture "$capture_dir/history-disabled.png" 532 240
for page in general appearance alerts monitoring; do validate_capture "$capture_dir/$page.png" 532 660; done
validate_capture "$capture_dir/monitoring-private.png" 532 395
validate_capture "$capture_dir/monitoring-health.png" 532 290

declare -A capture_digests=()
for image in activity device bar notification history history-disabled general appearance alerts monitoring monitoring-private monitoring-health; do
  digest=$(sha256sum "$capture_dir/$image.png" | awk '{print $1}')
  if [[ -n ${capture_digests[$digest]:-} ]]; then
    printf 'Duplicate captures: %s and %s\n' "${capture_digests[$digest]}" "$image" >&2
    exit 1
  fi
  capture_digests[$digest]=$image
done

optimize_png() {
  local source=$1 destination=$2
  magick "$source" -strip -define png:compression-level=9 "$destination"
  pngquant --force --quality=82-95 --speed 1 --strip --output "$destination" "$destination"
}

if [[ $verify_only == false ]]; then
  optimize_png "$capture_dir/activity.png" "$publish_dir/preview.png"
  install -m 0644 "$publish_dir/preview.png" "$publish_dir/docs/preview.png"
  optimize_png "$capture_dir/history.png" "$publish_dir/docs/history.png"
  optimize_png "$capture_dir/history-disabled.png" "$publish_dir/docs/history-disabled.png"
  for page in general appearance alerts monitoring; do
    optimize_png "$capture_dir/$page.png" "$publish_dir/docs/$page.png"
  done
  optimize_png "$capture_dir/monitoring-private.png" "$publish_dir/docs/monitoring-private.png"
  optimize_png "$capture_dir/monitoring-health.png" "$publish_dir/docs/monitoring-health.png"
  optimize_png "$capture_dir/device.png" "$publish_dir/docs/device.png"
  optimize_png "$capture_dir/bar.png" "$publish_dir/docs/bar.png"
  optimize_png "$capture_dir/notification.png" "$publish_dir/docs/notification.png"
  cp -- docs/index.html "$publish_dir/docs/index.html"
  cp -- README.md "$publish_dir/README.md"
  scripts/update-screenshot-metadata "$publish_dir/docs/index.html" "$publish_dir/docs" "$publish_dir/README.md"

  magick docs/social-card.png -fill '#0d110d' -draw 'rectangle 895,35 1729,875' "$capture_dir/social-base.png"
  magick "$capture_dir/activity.png" -resize 720x720 "$capture_dir/social-panel.png"
  magick "$capture_dir/social-base.png" "$capture_dir/social-panel.png" -geometry +950+95 -composite \
    -strip -define png:compression-level=9 "$publish_dir/docs/social-card.png"
  pngquant --force --quality=82-95 --speed 1 --strip \
    --output "$publish_dir/docs/social-card.png" "$publish_dir/docs/social-card.png"
fi

restore_desktop

verify_postconditions() {
  scripts/verify-capture-postconditions "$settings_snapshot" "$settings_file" "$history_snapshot" \
    "$monitor" "$original_workspace" "$initial_shell_pid" "$shell_pid" "$original_dnd_state"
}
write_report() {
  local destination=${report_file:-$capture_dir/verification.json}
  jq -n --arg mode "$([[ $verify_only == true ]] && printf verify || printf publish)" \
    --argjson pid "$initial_shell_pid" --arg monitor "$monitor" --argjson workspace "$original_workspace" \
    '{version:1,result:"passed",mode:$mode,shellPid:$pid,monitor:$monitor,restoredWorkspace:$workspace,settings:"untouched",history:"untouched",dnd:"preserved"}' >"$destination"
  if [[ -z $report_file ]]; then jq -c . "$destination"; else printf 'Verification report: %s\n' "$report_file"; fi
}
if [[ $verify_only == true ]]; then
  verify_postconditions
  write_report
  cleanup_capture
  trap - EXIT INT TERM
  printf 'Capture verification passed; repository assets were not published.\n'
  exit 0
fi

published_assets=(
  README.md preview.png docs/preview.png docs/history.png docs/history-disabled.png
  docs/general.png docs/appearance.png docs/alerts.png docs/monitoring.png
  docs/monitoring-private.png docs/monitoring-health.png docs/device.png docs/bar.png
  docs/notification.png docs/social-card.png docs/index.html
)
check_capture_environment
scripts/publish-screenshot-assets "$publish_dir" "${published_assets[@]}"
write_report

cleanup_capture
trap - EXIT INT TERM

printf 'Updated screenshots from %s workspace %s; restored workspace %s.\n' \
  "$monitor" "$capture_workspace" "$original_workspace"
