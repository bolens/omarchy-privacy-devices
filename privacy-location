#!/usr/bin/env python3
"""Report active GeoClue clients through bounded, argument-safe busctl calls."""

import json
import re
import subprocess


SERVICE = "org.freedesktop.GeoClue2"
MANAGER_PATH = "/org/freedesktop/GeoClue2/Manager"
CLIENT_PATH = re.compile(r"/org/freedesktop/GeoClue2/Client/\d+")
MAX_OUTPUT_BYTES = 64 * 1024
TEXT_CONTROLS = re.compile(r"[\x00-\x1f\x7f\u202a-\u202e\u2066-\u2069]")


def busctl(*arguments: str) -> str:
    result = subprocess.run(
        ["busctl", *arguments],
        check=False,
        capture_output=True,
        timeout=2,
    )
    if result.returncode != 0:
        return ""
    return result.stdout[:MAX_OUTPUT_BYTES].decode(errors="replace").strip()


def boolean_property(path: str, interface: str, name: str) -> bool:
    return busctl("get-property", SERVICE, path, interface, name) == "b true"


def desktop_id(path: str) -> str:
    value = busctl("get-property", SERVICE, path, "org.freedesktop.GeoClue2.Client", "DesktopId")
    if not value.startswith('s "') or not value.endswith('"'):
        return ""
    return TEXT_CONTROLS.sub("", value[3:-1]).strip()[:256]


def snapshot() -> dict:
    if not boolean_property(MANAGER_PATH, "org.freedesktop.GeoClue2.Manager", "InUse"):
        return {"type": "location-snapshot", "version": 1, "active": False, "applications": []}

    tree = busctl("tree", SERVICE)
    paths = sorted(set(CLIENT_PATH.findall(tree)))
    applications = {
        desktop_id(path)
        for path in paths
        if boolean_property(path, "org.freedesktop.GeoClue2.Client", "Active")
    }
    applications.discard("")
    return {
        "type": "location-snapshot",
        "version": 1,
        "active": True,
        "applications": sorted(applications, key=str.casefold),
    }


def main() -> int:
    try:
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    except (OSError, subprocess.SubprocessError):
        print(json.dumps({
            "type": "location-snapshot", "version": 1,
            "active": False, "applications": [], "healthy": False,
        }, separators=(",", ":")))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
