#!/usr/bin/env python3
"""Atomically maintain bounded privacy-session metadata in user state."""

import json
import fcntl
import math
import os
import re
import sys
import tempfile
import time
from contextlib import contextmanager
from pathlib import Path

MAX_ENTRIES = 100
MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000
MAX_FIELD_CHARS = 512
MAX_FILE_BYTES = 1048576
FIELDS = ("id", "kind", "application", "device", "source", "confidence", "detail", "startedAt", "endedAt", "durationMs")
TEXT_CONTROLS = re.compile(r"[\x00-\x1f\x7f\u202a-\u202e\u2066-\u2069]")


def state_file() -> Path:
    base = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    return base / "omarchy-privacy-devices" / "history.json"


@contextmanager
def locked(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    flags = os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW
    descriptor = os.open(path.parent / ".history.lock", flags, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def load(path: Path) -> list[dict]:
    try:
        with path.open() as stream:
            raw = stream.read(MAX_FILE_BYTES + 1)
        if len(raw.encode()) > MAX_FILE_BYTES:
            return []
        value = json.loads(raw)
        if not isinstance(value, list):
            return []
        clean = []
        for entry in value[:MAX_ENTRIES]:
            try:
                clean.append(sanitize(entry))
            except ValueError:
                continue
        return clean
    except (OSError, json.JSONDecodeError, RecursionError):
        return []


def sanitize(entry: object) -> dict:
    if not isinstance(entry, dict):
        raise ValueError("history entry must be an object")
    clean = {}
    for key in FIELDS:
        if key not in entry or not isinstance(entry[key], (str, int, float)):
            continue
        if isinstance(entry[key], str):
            clean[key] = TEXT_CONTROLS.sub("", entry[key]).strip()[:MAX_FIELD_CHARS]
        elif not isinstance(entry[key], bool) and math.isfinite(entry[key]):
            clean[key] = entry[key]
    if not all(key in clean for key in ("kind", "application", "startedAt", "endedAt")):
        raise ValueError("history entry is missing required fields")
    return clean


def bounded(entries: list[dict], now_ms: int) -> list[dict]:
    cutoff = now_ms - MAX_AGE_MS
    valid = [entry for entry in entries if isinstance(entry.get("endedAt"), (int, float)) and entry["endedAt"] >= cutoff]
    valid.sort(key=lambda entry: entry["endedAt"], reverse=True)
    unique = []
    seen = set()
    for entry in valid:
        identity = (entry.get("id") or (entry.get("kind"), entry.get("application"), entry.get("device"), entry.get("source")), entry["endedAt"])
        if identity in seen:
            continue
        seen.add(identity)
        unique.append(entry)
    return unique[:MAX_ENTRIES]


def append_entries(existing: list[dict], incoming: object, now_ms: int) -> list[dict]:
    values = incoming if isinstance(incoming, list) else [incoming]
    clean = [sanitize(entry) for entry in values[:MAX_ENTRIES]]
    return bounded(clean + existing, now_ms)


def save(path: Path, entries: list[dict]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".history-", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(entries, stream, separators=(",", ":"))
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        temporary.replace(path)
    except BaseException:
        temporary.unlink(missing_ok=True)
        raise


def main() -> int:
    action = sys.argv[1] if len(sys.argv) > 1 else "load"
    if not ((action in ("load", "clear") and len(sys.argv) == 2) or (action == "append" and len(sys.argv) == 3)):
        return 2
    path = state_file()
    with locked(path):
        if action == "load":
            existing = load(path)
            retained = bounded(existing, int(time.time() * 1000))
            if retained != existing and path.exists():
                save(path, retained)
            print(json.dumps(retained, separators=(",", ":")))
            return 0
        if action == "append":
            save(path, append_entries(load(path), json.loads(sys.argv[2]), int(time.time() * 1000)))
            return 0
        if action == "clear":
            try:
                path.unlink()
            except FileNotFoundError:
                pass
            return 0
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
