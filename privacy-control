#!/bin/sh
set -eu

action=${1:-}
kind=${2:-}

state_camera() {
  for interface in /sys/bus/usb/drivers/uvcvideo/*:*; do
    [ -e "$interface" ] && exit 10
  done
  exit 11
}

unbind_uvc_cameras() {
  interfaces=""
  for interface in /sys/bus/usb/drivers/uvcvideo/*:*; do
    [ -e "$interface" ] || continue
    interfaces="$interfaces ${interface##*/}"
  done
  [ -n "$interfaces" ] || return 0
  for interface in $interfaces; do
    [ -e "/sys/bus/usb/drivers/uvcvideo/$interface" ] || continue
    printf '%s' "$interface" | pkexec /usr/bin/tee /sys/bus/usb/drivers/uvcvideo/unbind >/dev/null
  done
}

bind_uvc_cameras() {
  for interface in /sys/bus/usb/devices/*:*; do
    [ -e "$interface/uevent" ] || continue
    [ ! -e "$interface/driver" ] || continue
    grep -q '^MODALIAS=usb:.*ic0Eisc0[12]' "$interface/uevent" || continue
    printf '%s' "${interface##*/}" | pkexec /usr/bin/tee /sys/bus/usb/drivers/uvcvideo/bind >/dev/null
  done
}

state_unit() {
  scope=$1
  unit=$2
  if [ "$scope" = user ]; then
    enabled=$(systemctl --user is-enabled "$unit" 2>/dev/null || true)
  else
    enabled=$(systemctl is-enabled "$unit" 2>/dev/null || true)
  fi
  if printf '%s\n' "$enabled" | grep -q '^masked'; then exit 11; else exit 10; fi
}

if [ "$action" = status ]; then
  case "$kind" in
    camera) state_camera ;;
    location) state_unit system geoclue.service ;;
    screen-share) state_unit user xdg-desktop-portal-hyprland.service ;;
    *) exit 12 ;;
  esac
fi

[ "$action" = toggle ] || exit 12
case "$kind" in
  camera)
    camera_is_bound=false
    for interface in /sys/bus/usb/drivers/uvcvideo/*:*; do
      if [ -e "$interface" ]; then camera_is_bound=true; break; fi
    done
    if [ "$camera_is_bound" = true ]; then unbind_uvc_cameras; else bind_uvc_cameras; fi
    ;;
  location)
    if systemctl is-enabled geoclue.service 2>/dev/null | grep -q '^masked'; then
      pkexec /usr/bin/systemctl unmask --runtime geoclue.service
      pkexec /usr/bin/systemctl start geoclue.service
    else
      pkexec /usr/bin/systemctl mask --runtime --now geoclue.service
    fi
    ;;
  screen-share)
    if systemctl --user is-enabled xdg-desktop-portal-hyprland.service 2>/dev/null | grep -q '^masked'; then
      systemctl --user unmask --runtime xdg-desktop-portal-hyprland.service
      systemctl --user start xdg-desktop-portal-hyprland.service
    else
      systemctl --user mask --runtime --now xdg-desktop-portal-hyprland.service
    fi
    ;;
  *) exit 12 ;;
esac
